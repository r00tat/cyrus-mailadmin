#!/usr/bin/env python3
"""Installer and updater for the mailadmin list delivery script (maillist.py and its sibling modules).

Standard library only. Layout under the prefix:

    <prefix>/.mailadmin-maillist   marker: this directory is ours
    <prefix>/releases/<id>/        one directory per installed release
    <prefix>/current               relative symlink to the active release
    <prefix>/previous              relative symlink to the release before it

Order: preflight, source, list user, configuration, log file, release directory, verification as the
list user, atomic activation, pruning, instructions. Nothing is switched before the verification passed,
and the first run (which only creates the configuration) leaves nothing under releases/.

The installer runs as root and writes into directories that other accounts may be able to influence, so
every file it creates or fixes is opened without following symlinks and checked on the descriptor, and
directories it did not create itself are only inspected, never changed.

Exit codes: 0 done, 1 failed, 2 configuration file created and still to be filled in.
"""

from __future__ import annotations

import argparse
import configparser
import hashlib
import io
import os
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from collections.abc import Callable
from pathlib import Path, PurePosixPath

if sys.version_info < (3, 11):  # noqa: UP036 - the installer may be started with an older host Python
    sys.exit("install: error: the installer needs Python 3.11 or newer")

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_CONFIG = 2

MARKER = ".mailadmin-maillist"
# The script and the modules it imports from its own directory. All of them make up a release: they are
# copied, compared and hashed together, so a release never mixes code from two versions.
CODE_FILES = ("maillist.py", "maillist_config.py", "maillist_delivery.py", "maillist_headers.py", "maillist_members.py")
RELEASE_FILES = (*CODE_FILES, "maillist.ini.example", "VERSION", "README.md")
OPTIONAL_FILES = ("README.md",)
DEFAULT_PREFIX = "/opt/mailadmin-maillist"
DEFAULT_CONFIG = "/etc/mailadmin-maillist/maillist.ini"
DEFAULT_REPO = "r00tat/cyrus-mailadmin"
MAX_ARCHIVE_BYTES = 50 * 1024 * 1024
MAX_SUMS_BYTES = 1024 * 1024
CHECK_TIMEOUT = 60
TOOL_PATH = "/usr/sbin:/usr/bin:/sbin:/bin"

_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
_BAD_PATH_RE = re.compile(r"[\s$]")


class InstallError(Exception):
    """A step failed; the message is shown to the operator."""


class Runner:
    """System commands. Tests replace this class; nothing else in the installer touches the system."""

    def is_root(self) -> bool:
        return os.geteuid() == 0

    def trusted_uids(self) -> set[int]:
        """Owners we accept for directories we did not create: root, plus ourselves when not root."""
        euid = os.geteuid()
        return {0} if euid == 0 else {0, euid}

    def user_exists(self, name: str) -> bool:
        import pwd

        try:
            pwd.getpwnam(name)
        except KeyError:
            return False
        return True

    def create_user(self, name: str) -> None:
        cmd = ["useradd", "--system", "--no-create-home", "--shell", "/usr/sbin/nologin", "--user-group", name]
        result = subprocess.run(cmd, capture_output=True, text=True, check=False)  # noqa: S603
        if result.returncode != 0:
            raise InstallError(f"useradd failed: {result.stderr.strip()}")

    def chown(self, path: Path, user: str, group: str) -> None:
        shutil.chown(path, user=user, group=group)

    def fchown(self, fd: int, user: str, group: str) -> None:
        import grp
        import pwd

        os.fchown(fd, pwd.getpwnam(user).pw_uid, grp.getgrnam(group).gr_gid)

    def check_dependency(self, python: str) -> bool:
        # -I and cwd="/": without them "-c" puts the caller's working directory first on sys.path, and a
        # planted mysql/ there would run as root. -B: a check run as root leaves no bytecode files behind.
        result = subprocess.run(  # noqa: S603
            [python, "-I", "-B", "-c", "import mysql.connector"], capture_output=True, text=True, check=False, cwd="/"
        )
        return result.returncode == 0

    def run_check(self, python: str, script: Path, config: Path, user: str | None) -> tuple[bool, str]:
        # -I and cwd="/" as in check_dependency: nothing from the caller's directory or environment is imported.
        # -B: importing the modules must not leave a __pycache__ in the release directory, least of all as root.
        cmd = [python, "-I", "-B", str(script), "--check"]
        if user and self.is_root():
            # The check itself gets a minimal PATH, so the privilege-dropping tool is resolved here.
            runuser = shutil.which("runuser", path=TOOL_PATH)
            setpriv = None if runuser else shutil.which("setpriv", path=TOOL_PATH)
            if runuser:
                cmd = [runuser, "-u", user, "--", *cmd]
            elif setpriv:
                import pwd

                info = pwd.getpwnam(user)
                cmd = [setpriv, f"--reuid={info.pw_uid}", f"--regid={info.pw_gid}", "--init-groups", *cmd]
            else:
                raise InstallError("neither runuser nor setpriv found; cannot run --check as the list user")
        # Minimal environment: the check must behave like Postfix's pipe(8), which passes nothing along.
        env = {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "MAILLIST_CONFIG": str(config)}
        try:
            result = subprocess.run(  # noqa: S603
                cmd, capture_output=True, text=True, env=env, timeout=CHECK_TIMEOUT, check=False, cwd="/"
            )
        except subprocess.TimeoutExpired:
            return False, f"--check timed out after {CHECK_TIMEOUT} seconds"
        return result.returncode == 0, (result.stdout + result.stderr).strip()


class _HttpsOnlyRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001, ANN201
        if not newurl.startswith("https://"):
            raise InstallError("refusing a redirect to a non-https URL")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def _opener():  # noqa: ANN202
    return urllib.request.build_opener(_HttpsOnlyRedirect)


def default_fetch(url: str) -> bytes:
    if not url.startswith("https://"):
        raise InstallError(f"refusing to download from a non-https URL: {url}")
    with _opener().open(url, timeout=60) as response:
        data = response.read(MAX_ARCHIVE_BYTES + 1)
    if len(data) > MAX_ARCHIVE_BYTES:
        raise InstallError("download is too large")
    return data


def default_final_url(url: str) -> str:
    if not url.startswith("https://"):
        raise InstallError(f"refusing to follow a non-https URL: {url}")
    with _opener().open(url, timeout=60) as response:
        return response.geturl()


def open_regular(path: Path, flags: int, mode: int = 0o640) -> int:
    """Open without following symlinks and require a plain, singly linked file. Returns the descriptor."""
    try:
        fd = os.open(path, flags | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    except OSError as exc:
        raise InstallError(f"cannot open {path} safely: {exc.strerror}") from exc
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise InstallError(f"{path} is not a plain file with a single link; refusing to touch it")
    except BaseException:
        os.close(fd)
        raise
    return fd


def code_digest(src: Path) -> str:
    """SHA-256 over every code file, name and content, so a change in any module gives a new dev release id."""
    digest = hashlib.sha256()
    for name in CODE_FILES:
        data = (src / name).read_bytes()
        digest.update(f"{name}\0{len(data)}\0".encode())
        digest.update(data)
    return digest.hexdigest()


class Installer:
    def __init__(self, args, runner, fetch, final_url, out=print):  # noqa: ANN001
        self.args = args
        self.runner = runner
        self.fetch = fetch
        self.final_url = final_url
        self.say = out
        self.dry = args.dry_run
        self.prefix = Path(args.prefix)
        self.config = Path(args.config)
        self.user = None if args.no_user else args.user
        self.links: dict[str, str | None] = {}

    # -- helpers ---------------------------------------------------------------------------

    def step(self, text: str) -> None:
        self.say(("would: " if self.dry else "") + text)

    def marker_present(self) -> bool:
        return (self.prefix / MARKER).is_file()

    def require_trusted_dir(self, path: Path, what: str) -> None:
        info = path.stat()
        if info.st_uid not in self.runner.trusted_uids():
            raise InstallError(f"{what} {path} is not owned by root; refusing to use it")
        if info.st_mode & 0o022:
            raise InstallError(f"{what} {path} is writable by group or others; refusing to use it")

    def make_dir(self, path: Path, mode: int, owner: tuple[str, str] | None = None) -> None:
        """Create a missing directory (and parents) below a trusted ancestor; set mode and owner on the fd."""
        ancestor = path
        while not ancestor.exists():
            ancestor = ancestor.parent
        self.require_trusted_dir(ancestor, "parent directory")
        path.mkdir(parents=True)
        try:
            fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError as exc:
            raise InstallError(f"cannot open new directory {path} safely: {exc.strerror}") from exc
        try:
            os.fchmod(fd, mode)
            if owner:
                self.runner.fchown(fd, *owner)
        finally:
            os.close(fd)

    def check_prefix_trust(self) -> None:
        if self.prefix.is_dir():
            self.require_trusted_dir(self.prefix, "prefix")
            releases = self.prefix / "releases"
            if releases.is_symlink():
                raise InstallError(f"{releases} is a symlink; refusing to use it")
            if releases.is_dir():
                self.require_trusted_dir(releases, "releases directory")

    def require_ours(self) -> None:
        if not self.prefix.is_dir() or not self.marker_present():
            raise InstallError(f"{self.prefix} is not a maillist installation (marker {MARKER} missing)")
        self.check_prefix_trust()

    @staticmethod
    def atomic_symlink(link: Path, target: str) -> None:
        tmp = link.with_name(f".{link.name}.tmp")
        if tmp.is_symlink() or tmp.exists():
            tmp.unlink()
        os.symlink(target, tmp)
        os.replace(tmp, link)

    @staticmethod
    def link_target(link: Path) -> str | None:
        return os.readlink(link) if link.is_symlink() else None

    def effective_link(self, name: str) -> str | None:
        """Where a link points, or would point after the (possibly dry) activation."""
        if name in self.links:
            return self.links[name]
        return self.link_target(self.prefix / name)

    # -- 1. preflight ----------------------------------------------------------------------

    def validate_paths(self, *, install: bool) -> None:
        names = {"--prefix": self.args.prefix}
        if install:
            names.update({"--config": self.args.config, "--python": self.args.python})
        for flag, value in names.items():
            if not os.path.isabs(value):
                raise InstallError(f"{flag} must be an absolute path")
            if _BAD_PATH_RE.search(value):
                raise InstallError(f"{flag} must not contain whitespace or '$' (it ends up in master.cf)")

    def preflight(self) -> None:
        self.validate_paths(install=True)
        if self.args.keep_releases < 1:
            raise InstallError("--keep-releases must be at least 1")
        if self.user and not self.dry and not self.runner.is_root():
            raise InstallError("run as root, or pass --no-user to install without a dedicated list user")
        if self.prefix.exists():
            if not self.prefix.is_dir():
                raise InstallError(f"{self.prefix} exists and is not a directory")
            if any(self.prefix.iterdir()) and not self.marker_present():
                raise InstallError(
                    f"{self.prefix} is not empty and has no {MARKER} marker; refusing to touch a foreign directory"
                )
            self.check_prefix_trust()
        if not self.args.no_verify and not self.runner.check_dependency(self.args.python):
            raise InstallError(
                f"{self.args.python} cannot import mysql.connector: "
                "install python3-mysql.connector (Debian) or mysql-connector-python"
            )

    # -- 2. source -------------------------------------------------------------------------

    def resolve_tag(self) -> str:
        repo = self.args.repo
        if not _REPO_RE.match(repo) or ".." in repo:
            raise InstallError(f"invalid --repo: {repo!r}")
        tag = self.args.release
        if tag == "latest":
            final = self.final_url(f"https://github.com/{repo}/releases/latest")
            expected = f"https://github.com/{repo}/releases/tag/"
            if not final.startswith(expected):
                raise InstallError("GitHub did not redirect 'latest' to a release tag of that repository")
            tag = final[len(expected) :]
        if not _ID_RE.match(tag):
            raise InstallError(f"invalid release tag: {tag!r}")
        return tag

    def download_release(self, workdir: Path) -> Path:
        tag = self.resolve_tag()
        base = f"https://github.com/{self.args.repo}/releases/download/{tag}"
        name = f"maillist-{tag}.tar.gz"
        self.say(f"downloading {name} from {self.args.repo}")
        archive = self.fetch(f"{base}/{name}")
        if len(archive) > MAX_ARCHIVE_BYTES:
            raise InstallError("release archive is too large")
        sums_raw = self.fetch(f"{base}/SHA256SUMS")
        if len(sums_raw) > MAX_SUMS_BYTES:
            raise InstallError("SHA256SUMS is too large")
        entries = []
        for line in sums_raw.decode("utf-8", "replace").splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[1].lstrip("*") == name:
                entries.append(parts[0].lower())
        if not entries:
            raise InstallError(f"SHA256SUMS has no entry for {name}")
        if len(entries) > 1:
            raise InstallError(f"SHA256SUMS names {name} more than once")
        expected = entries[0]
        if hashlib.sha256(archive).hexdigest() != expected:
            raise InstallError(f"checksum mismatch for {name}")
        self.say("checksum ok")
        extract_archive(archive, workdir)
        roots = [p for p in workdir.iterdir() if p.is_dir()]
        if len(roots) != 1:
            raise InstallError("the release archive must contain exactly one top-level directory")
        return roots[0]

    def find_source(self, workdir: Path) -> Path:
        if self.args.release:
            return self.download_release(workdir)
        src = Path(self.args.source) if self.args.source else Path(__file__).resolve().parent
        for name in CODE_FILES:
            if not (src / name).is_file():
                raise InstallError(f"no {name} in {src}; use --source DIR or --release TAG")
        return src

    # -- release directory -----------------------------------------------------------------------

    def release_id(self, src: Path) -> str:
        version = (src / "VERSION").read_text().strip() if (src / "VERSION").is_file() else "dev"
        if version == "dev":
            digest = code_digest(src)[:8]
            return f"dev-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{digest}"
        if not _ID_RE.match(version):
            raise InstallError(f"invalid VERSION {version!r}")
        return version

    def create_release(self, src: Path, release: str) -> tuple[Path, bool]:
        """Return (release directory, created in this run)."""
        target = self.prefix / "releases" / release
        if target.exists():
            for name in RELEASE_FILES:
                if (src / name).is_file() and (
                    not (target / name).is_file() or (target / name).read_bytes() != (src / name).read_bytes()
                ):
                    raise InstallError(f"release {release} already exists with different content")
            self.step(f"reuse existing release {release}")
            return target, False
        self.step(f"create release {target}")
        if self.dry:
            return target, True
        releases = self.prefix / "releases"
        prefix_new, releases_new = not self.prefix.exists(), not releases.exists()
        if prefix_new:
            self.make_dir(self.prefix, 0o755)
        if releases_new:
            self.make_dir(releases, 0o755)
        marker = self.prefix / MARKER
        if not marker.exists():
            marker.write_text("Managed by maillist/install. Do not put other files here.\n")
            os.chmod(marker, 0o644)
        staging = Path(tempfile.mkdtemp(prefix=".staging-", dir=releases))
        try:
            for name in RELEASE_FILES:
                source = src / name
                if not source.is_file():
                    if name in OPTIONAL_FILES:
                        continue
                    raise InstallError(f"{source} is missing")
                shutil.copyfile(source, staging / name)
                os.chmod(staging / name, 0o644)
            os.chmod(staging, 0o755)  # noqa: S103
            # Strictly increasing mtimes give pruning a reliable order even on coarse clocks.
            newest = max((p.stat().st_mtime_ns for p in releases.iterdir() if not p.name.startswith(".")), default=0)
            stamp = max(time.time_ns(), newest + 1)
            os.utime(staging, ns=(stamp, stamp))
            os.rename(staging, target)
        except BaseException:
            shutil.rmtree(staging, ignore_errors=True)
            raise
        return target, True

    # -- list user -------------------------------------------------------------------------------

    def ensure_user(self) -> None:
        if not self.user or self.runner.user_exists(self.user):
            return
        self.step(f"create system user {self.user}")
        if not self.dry:
            self.runner.create_user(self.user)

    # -- configuration and log ---------------------------------------------------------------------

    def ensure_config(self, src: Path) -> bool:
        """Return True when the file was just created and has to be filled in."""
        parent = self.config.parent
        parent_new = not parent.exists()
        if not parent_new:
            # A directory we did not create (/etc, a shared mount) is only inspected, never changed.
            self.require_trusted_dir(parent, "configuration directory")
        if os.path.lexists(self.config):
            self.step(f"keep existing configuration {self.config} (fixing permissions only)")
            if self.dry:
                return False
            fd = open_regular(self.config, os.O_RDONLY)
            try:
                os.fchmod(fd, 0o640)
                if self.user:
                    self.runner.fchown(fd, "root", self.user)
            finally:
                os.close(fd)
            return False
        self.step(f"create {self.config} from the example (mode 0640)")
        if self.dry:
            return True
        if parent_new:
            self.make_dir(parent, 0o750, ("root", self.user) if self.user else None)  # noqa: S103
        fd = open_regular(self.config, os.O_WRONLY | os.O_CREAT | os.O_EXCL)
        try:
            with os.fdopen(os.dup(fd), "wb") as handle:
                handle.write((src / "maillist.ini.example").read_bytes())
            os.fchmod(fd, 0o640)
            if self.user:
                self.runner.fchown(fd, "root", self.user)
        except BaseException:
            self.config.unlink(missing_ok=True)  # never leave a half-written configuration behind
            raise
        finally:
            os.close(fd)
        return True

    def log_path(self) -> Path:
        try:
            text = self.config.read_text(encoding="utf-8")
        except OSError as exc:
            if not self.dry:
                raise InstallError(f"cannot read {self.config}: {exc.strerror}") from exc
            self.say(f"note: cannot read {self.config} here; the log path shown may be the default")
            text = ""
        parser = configparser.ConfigParser(interpolation=None)
        try:
            parser.read_string(text)
        except configparser.Error as exc:
            raise InstallError(f"cannot parse {self.config}: {type(exc).__name__}") from exc
        return Path(parser.get("log", "file", fallback="/var/log/mail/maillist.log").strip())

    def ensure_log(self) -> None:
        log = self.log_path()
        parent = log.parent
        parent_new = not parent.exists()
        if not parent_new:
            self.require_trusted_dir(parent, "log directory")
        self.step(f"ensure log file {log} (mode 0640)")
        if self.dry:
            return
        if parent_new:
            self.make_dir(parent, 0o755)
        fd = open_regular(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT)
        try:
            os.fchmod(fd, 0o640)
            if self.user:
                self.runner.fchown(fd, self.user, self.user)
        finally:
            os.close(fd)

    # -- verify ------------------------------------------------------------------------------------

    def verify(self, release_dir: Path) -> None:
        if self.args.no_verify:
            self.say("skipping verification (--no-verify)")
            return
        self.step(f"run {release_dir.name}/maillist.py --check as {self.user or 'the current user'}")
        if self.dry:
            return
        ok, output = self.runner.run_check(self.args.python, release_dir / "maillist.py", self.config, self.user)
        if output:
            self.say(output)
        if not ok:
            raise InstallError("verification failed; the active release was not changed")

    # -- activate and prune ---------------------------------------------------------------------------

    def activate(self, release: str) -> None:
        new_target = f"releases/{release}"
        current = self.prefix / "current"
        old_target = self.link_target(current)
        self.step(f"switch current -> {new_target}")
        previous = (
            old_target if old_target is not None and old_target != new_target else self.effective_link("previous")
        )
        self.links = {"current": new_target, "previous": previous}
        if self.dry:
            return
        if previous is not None and previous != self.link_target(self.prefix / "previous"):
            self.atomic_symlink(self.prefix / "previous", previous)
        self.atomic_symlink(current, new_target)

    def prune(self, release: str) -> None:
        releases = self.prefix / "releases"
        if not releases.is_dir():
            return
        keep_names = {Path(t).name for t in (self.effective_link("current"), self.effective_link("previous")) if t}
        entries = sorted(
            (p for p in releases.iterdir() if p.is_dir() and not p.is_symlink() and not p.name.startswith(".")),
            key=lambda p: (p.stat().st_mtime_ns, p.name),
        )
        names = [p.name for p in entries]
        if release not in names:
            names.append(release)  # a release about to exist counts as the newest
        keep_names.update(names[-self.args.keep_releases :])
        for entry in entries:
            if entry.name not in keep_names:
                self.step(f"remove old release {entry.name}")
                if not self.dry:
                    shutil.rmtree(entry)

    # -- instructions -----------------------------------------------------------------------------------

    def instructions(self) -> None:
        user = self.user or "<list user>"
        # pipe(8) passes no environment, so a non-default configuration path has to travel in argv.
        env_part = ""
        if self.config != Path(DEFAULT_CONFIG):
            env_part = f"/usr/bin/env MAILLIST_CONFIG={self.config} "
        self.say("")
        self.say("Add this service to Postfix master.cf (continuation lines are indented):")
        self.say("")
        self.say("maillist  unix  -  n  n  -  -  pipe")
        # -I: nothing from the environment or a user site directory reaches the script; maillist.py puts its
        # own release directory on sys.path itself.
        script = f"{self.prefix}/current/maillist.py"
        self.say(f"  flags=Rq user={user} argv={env_part}{self.args.python} -I {script} -- ${{user}}")
        self.say("")
        self.say("and in main.cf, so that every list member gets its own delivery:")
        self.say("")
        self.say("maillist_destination_recipient_limit = 1")
        self.say("")
        self.say("See docs/deployment/maillist.md for the transport map and the rest of the setup.")

    # -- commands ----------------------------------------------------------------------------------------

    def install(self) -> int:
        self.preflight()
        with tempfile.TemporaryDirectory(prefix="maillist-install-") as tmp:
            src = self.find_source(Path(tmp))
            release = self.release_id(src)
            self.ensure_user()
            if self.ensure_config(src):
                self.say(
                    f"Configuration created at {self.config}. Fill in the required keys, then run the installer again."
                )
                return EXIT_CONFIG
            self.ensure_log()
            release_dir, created = self.create_release(src, release)
            try:
                self.verify(release_dir)
            except InstallError:
                if created and not self.dry:
                    shutil.rmtree(release_dir, ignore_errors=True)
                raise
        self.activate(release)
        self.prune(release)
        if not self.dry:
            self.say(f"installed release {release}")
        self.instructions()
        return EXIT_OK

    def rollback(self) -> int:
        self.validate_paths(install=False)
        self.require_ours()
        current, previous = self.prefix / "current", self.prefix / "previous"
        cur, prev = self.link_target(current), self.link_target(previous)
        if cur is None or prev is None:
            raise InstallError("nothing to roll back to: current and previous are both required")
        if not (self.prefix / prev).is_dir():
            raise InstallError(f"previous release {prev} no longer exists")
        self.step(f"switch current -> {prev}, previous -> {cur}")
        if not self.dry:
            self.atomic_symlink(current, prev)
            self.atomic_symlink(previous, cur)
            self.say(f"rolled back to {prev}")
        return EXIT_OK

    def status(self) -> int:
        self.validate_paths(install=False)
        self.require_ours()
        for link in ("current", "previous"):
            target = self.link_target(self.prefix / link)
            self.say(f"{link:<9}-> {target if target else '(none)'}")
        self.say("releases:")
        releases = self.prefix / "releases"
        names = sorted(p.name for p in releases.iterdir() if p.is_dir() and not p.name.startswith("."))
        for name in names:
            self.say(f"  {name}")
        return EXIT_OK


def extract_archive(data: bytes, dest: Path) -> None:
    """Unpack a release archive after checking every member; refuse anything but files and directories."""
    if len(data) > MAX_ARCHIVE_BYTES:
        raise InstallError("release archive is too large")
    try:
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
            _extract_checked(tar, dest)
    except (tarfile.TarError, EOFError) as exc:
        raise InstallError(f"cannot read the release archive: {type(exc).__name__}") from exc


def _extract_checked(tar: tarfile.TarFile, dest: Path) -> None:
    members = tar.getmembers()
    total = 0
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts or not member.name:
            raise InstallError(f"unsafe path in archive: {member.name!r}")
        if not (member.isreg() or member.isdir()):
            raise InstallError(f"unsupported member type in archive: {member.name!r}")
        total += member.size
    if total > MAX_ARCHIVE_BYTES:
        raise InstallError("release archive expands to too much data")
    if hasattr(tarfile, "data_filter"):
        tar.extractall(dest, members=members, filter="data")  # noqa: S202
    else:  # pragma: no cover - Python without extraction filters
        tar.extractall(dest, members=members)  # noqa: S202


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Install, update, roll back or inspect the maillist script.")
    source = parser.add_mutually_exclusive_group()
    source.add_argument(
        "--source", metavar="DIR", help="directory holding maillist.py and its modules (default: next to this script)"
    )
    source.add_argument("--release", metavar="TAG|latest", help="install a GitHub release")
    parser.add_argument(
        "--repo", default=DEFAULT_REPO, help=f"OWNER/NAME of the release repository (default: {DEFAULT_REPO})"
    )
    parser.add_argument("--prefix", default=DEFAULT_PREFIX)
    parser.add_argument("--config", default=DEFAULT_CONFIG)
    user = parser.add_mutually_exclusive_group()
    user.add_argument("--user", default="maillist", help="list user the script runs as (default: maillist)")
    user.add_argument("--no-user", action="store_true", help="do not create or use a dedicated user (no root needed)")
    parser.add_argument(
        "--python", default="/usr/bin/python3", help="absolute path of the interpreter Postfix will run the script with"
    )
    parser.add_argument("--keep-releases", type=int, default=3)
    parser.add_argument("--no-verify", action="store_true", help="skip dependency and --check verification")
    parser.add_argument("--dry-run", action="store_true", help="print every step, change nothing")
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--rollback", action="store_true", help="swap current and previous")
    action.add_argument("--status", action="store_true", help="show current, previous and installed releases")
    return parser


def isolation_warning() -> str | None:
    """A warning when the installer itself was not started with ``python3 -I``.

    Without -I the directory holding this script comes first on sys.path, so a module planted next to it
    (for example in a shared download directory) would be imported as root. Only a warning: refusing would
    break existing automation for no gain when the directory is trusted.
    """
    if sys.flags.isolated:
        return None
    return (
        "install: warning: not started with 'python3 -I'; modules next to this script or in the current "
        "directory could be imported. Run it from a fresh directory as 'sudo python3 -I install-maillist'."
    )


def main(
    argv: list[str] | None = None,
    runner: Runner | None = None,
    fetch: Callable[[str], bytes] | None = None,
    final_url: Callable[[str], str] | None = None,
) -> int:
    args = build_parser().parse_args(argv)
    installer = Installer(args, runner or Runner(), fetch or default_fetch, final_url or default_final_url)
    old_umask = os.umask(0o022)  # created directories must not depend on the caller's umask
    try:
        if args.rollback:
            return installer.rollback()
        if args.status:
            return installer.status()
        return installer.install()
    except (InstallError, OSError) as exc:
        print(f"install: error: {exc}", file=sys.stderr)
        return EXIT_FAIL
    finally:
        os.umask(old_umask)


if __name__ == "__main__":
    _warning = isolation_warning()
    if _warning:
        print(_warning, file=sys.stderr)
    sys.exit(main())
