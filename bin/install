#!/usr/bin/env bash
#
# mailadmin — installer and updater.
#
# Fetches a revision, builds it, migrates the database and switches the web
# server over to it. Every step is one docs/deployment/installation.md describes
# by hand; the script adds nothing the manual path does not have, it only makes
# the order impossible to get wrong.
#
# Layout on the server (deployment variant A, U-25):
#
#   <prefix>/releases/<id>/   one directory per installed revision
#   <prefix>/current          symlink to the active release; the vHost points at
#                             <prefix>/current/public
#   <env-file>                the configuration, KEY='value' per line; read by
#                             the php-fpm pool (generated from it) and by the
#                             command line wrapper, never stored in a release
#
# Order, and why:
#
#    1. preflight       tools and versions, before anything is changed
#    2. configuration   the env file; on the first run it is created with a
#                       fresh signing key and the script stops so that it can be
#                       completed
#    3. fetch           git clone into a new release directory
#    4. build           composer (no dev) and the frontend, as an unprivileged
#                       user; the release is root-owned afterwards
#    5. migrate         from the NEW release while the OLD one still serves.
#                       Migrations are additive (CLAUDE.md, rule 1), so the old
#                       code keeps working; the new code refuses service until
#                       they have run
#    6. php-fpm pool    generated from the env file and tested
#    7. activate        atomic symlink switch, php-fpm reload (opcache)
#    8. cli + cron      /usr/local/sbin/mailadmin and the hourly token cleanup
#    9. apache          optional (--apache): vHost, modules, configtest, reload
#   10. verify          bin/check-deployment.php against the public URL
#   11. prune           releases beyond --keep-releases
#
# Run it as root for a server installation. With --no-system it only fetches,
# builds and migrates into --prefix as the current user — for a build host or a
# trial run.
#
# Exit codes: 0 done, 1 failed, 2 env file created and to be completed first.

set -euo pipefail

readonly MARKER='Generated by mailadmin bin/install'
readonly PLACEHOLDER='CHANGEME'
readonly MIN_PHP_MAJOR=8 MIN_PHP_MINOR=3 MIN_NODE=20
readonly PHP_EXTENSIONS=(pdo_mysql sodium openssl json iconv filter)
readonly REQUIRED_KEYS=(
    MAILADMIN_ENV
    MAILADMIN_DB_DSN MAILADMIN_DB_USER MAILADMIN_DB_PASSWORD
    MAILADMIN_JWT_SIGNING_KEY
    MAILADMIN_IMAP_HOST MAILADMIN_IMAP_ADMIN_USER MAILADMIN_IMAP_ADMIN_PASSWORD
)
readonly CLI_COMMANDS='migrate|db-check|prune-tokens|check-deployment'

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# --- options ------------------------------------------------------------------

repo=''
ref=''
prefix='/srv/mailadmin'
env_file='/etc/mailadmin/mailadmin.env'
base_path=''
keep_releases=3
keep_node_modules=0
system=1
app_user='mailadmin'
web_group='www-data'
php_version=''
fpm_socket='/run/php/mailadmin.sock'
install_packages=0
skip_migrate=0
server_name=''
apache=0
tls_cert=''
tls_key=''
prefill_db_dsn=''
prefill_db_user=''
prefill_imap_host=''
prefill_imap_admin=''
rollback=0
dry_run=0

usage() {
    cat <<'USAGE'
Usage: bin/install [options]

Install or update mailadmin: fetch, build, migrate, activate.
See docs/deployment/installation.md.

Source
  --repo URL|PATH         git repository to clone
                          (default: 'origin' of the checkout this script is in)
  --ref REF               branch, tag or commit (default: the default branch)

Target
  --prefix DIR            installation root (default: /srv/mailadmin)
  --env-file FILE         configuration (default: /etc/mailadmin/mailadmin.env)
  --base-path PATH        URL prefix such as /mailadmin (default: none)
  --keep-releases N       releases to keep, at least 2 (default: 3)
  --keep-node-modules     keep frontend/node_modules after the build

System
  --no-system             only fetch, build and migrate, as the current user;
                          no system user, pool, cron or web server changes
  --user NAME             system user of the php-fpm pool (default: mailadmin)
  --web-group NAME        group of the web server (default: www-data)
  --php-version X.Y       php-fpm version (default: that of the php CLI)
  --fpm-socket PATH       pool socket (default: /run/php/mailadmin.sock)
  --install-packages      install git, composer, node and php-fpm via apt-get
  --skip-migrate          do not run database migrations

Web server
  --server-name HOST      public host name; enables the deployment check
  --apache                write and enable an Apache vHost (variant A)
  --tls-cert FILE         certificate for --apache
  --tls-key FILE          private key for --apache

First run (prefill the env file)
  --db-dsn DSN  --db-user NAME  --imap-host HOST  --imap-admin-user NAME

Other
  --rollback              switch back to the previous release and stop
  --dry-run               show what would happen, change nothing
  -h, --help              this text

Exit codes: 0 done, 1 failed, 2 env file created and to be completed first.
USAGE
}

need_value() {
    [ "$#" -ge 2 ] && [ -n "$2" ] || die "option $1 needs a value"
}

parse_args() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo)              need_value "$@"; repo=$2; shift ;;
            --ref)               need_value "$@"; ref=$2; shift ;;
            --prefix)            need_value "$@"; prefix=$2; shift ;;
            --env-file)          need_value "$@"; env_file=$2; shift ;;
            --base-path)         need_value "$@"; base_path=$2; shift ;;
            --keep-releases)     need_value "$@"; keep_releases=$2; shift ;;
            --keep-node-modules) keep_node_modules=1 ;;
            --no-system)         system=0 ;;
            --user)              need_value "$@"; app_user=$2; shift ;;
            --web-group)         need_value "$@"; web_group=$2; shift ;;
            --php-version)       need_value "$@"; php_version=$2; shift ;;
            --fpm-socket)        need_value "$@"; fpm_socket=$2; shift ;;
            --install-packages)  install_packages=1 ;;
            --skip-migrate)      skip_migrate=1 ;;
            --server-name)       need_value "$@"; server_name=$2; shift ;;
            --apache)            apache=1 ;;
            --tls-cert)          need_value "$@"; tls_cert=$2; shift ;;
            --tls-key)           need_value "$@"; tls_key=$2; shift ;;
            --db-dsn)            need_value "$@"; prefill_db_dsn=$2; shift ;;
            --db-user)           need_value "$@"; prefill_db_user=$2; shift ;;
            --imap-host)         need_value "$@"; prefill_imap_host=$2; shift ;;
            --imap-admin-user)   need_value "$@"; prefill_imap_admin=$2; shift ;;
            --rollback)          rollback=1 ;;
            --dry-run)           dry_run=1 ;;
            -h|--help)           usage; exit 0 ;;
            *)                   usage >&2; die "unknown option: $1" ;;
        esac
        shift
    done

    [[ $keep_releases =~ ^[0-9]+$ ]] && [ "$keep_releases" -ge 2 ] \
        || die '--keep-releases must be a number of at least 2, so that a rollback has somewhere to go'

    # Normalise: no trailing slash, and a leading one when set.
    base_path=${base_path%/}
    if [ -n "$base_path" ] && [ "${base_path#/}" = "$base_path" ]; then
        base_path="/$base_path"
    fi
    prefix=${prefix%/}
}

# --- helpers --------------------------------------------------------------------

log()  { printf '==> %s\n' "$*"; }
info() { printf '    %s\n' "$*"; }
die()  { printf '\nmailadmin install: %s\n' "$*" >&2; exit 1; }

is_root() { [ "$(id -u)" -eq 0 ]; }

# Runs a command that changes something; in a dry run it is only printed.
run() {
    if [ "$dry_run" -eq 1 ]; then
        info "[dry-run] $*"
        return 0
    fi
    "$@"
}

# Environment for the build and the command line tools: nothing inherited but
# PATH, so that a stray MAILADMIN_* in the operator's shell cannot leak in.
app_home() {
    if [ "$system" -eq 1 ] && is_root && id "$app_user" >/dev/null 2>&1; then
        getent passwd "$app_user" | cut -d: -f6
    else
        printf '%s\n' "${HOME:-/tmp}"
    fi
}

# as_app [VAR=value ...] -- command [args ...]
# Runs unprivileged: as the pool user when installing as root, as the caller
# otherwise. Composer and npm execute third-party code; none of it runs as root.
as_app() {
    local assignments=()
    while [ "$#" -gt 0 ] && [ "$1" != '--' ]; do
        assignments+=("$1")
        shift
    done
    shift

    local command=(env -i "HOME=$(app_home)" "PATH=$PATH" 'LANG=C.UTF-8' "${assignments[@]}" "$@")
    if [ "$system" -eq 1 ] && is_root; then
        command=(runuser -u "$app_user" -- "${command[@]}")
    fi
    run "${command[@]}"
}

# write_file PATH MODE [GROUP] — content from stdin, replaced atomically.
write_file() {
    local path=$1 mode=$2 group=${3:-}
    if [ "$dry_run" -eq 1 ]; then
        cat >/dev/null
        info "[dry-run] write $path (mode $mode)"
        return 0
    fi
    mkdir -p "$(dirname "$path")"
    local tmp="$path.tmp.$$"
    cat >"$tmp"
    chmod "$mode" "$tmp"
    if [ -n "$group" ] && is_root; then
        chown "root:$group" "$tmp"
    fi
    mv -f "$tmp" "$path"
    info "wrote $path"
}

# Never overwrite a file somebody wrote by hand.
guard_generated() {
    if [ -e "$1" ] && ! grep -qF "$MARKER" "$1"; then
        die "$1 exists and was not written by this installer. Move it away or merge it by hand."
    fi
}

fpm_service() { printf 'php%s-fpm\n' "$php_version"; }
pool_file()   { printf '/etc/php/%s/fpm/pool.d/mailadmin.conf\n' "$php_version"; }

public_url() {
    [ -n "$server_name" ] && printf 'https://%s%s\n' "$server_name" "$base_path"
}

# Releases in installation order (the name starts with a UTC timestamp).
list_releases() {
    [ -d "$prefix/releases" ] || return 0
    find "$prefix/releases" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | LC_ALL=C sort
}

active_release() {
    [ -L "$prefix/current" ] && basename "$(readlink "$prefix/current")"
}

reload_fpm() {
    [ "$system" -eq 1 ] && run systemctl reload-or-restart "$(fpm_service)"
    return 0
}

# Atomic: a request sees either the old release or the new one.
switch_to() {
    run ln -sfn "releases/$1" "$prefix/current.new"
    run mv -T "$prefix/current.new" "$prefix/current"
}

# --- configuration ----------------------------------------------------------------

declare -A config=()

# Reads the env file the way sh does — the CLI wrapper sources it — and keeps
# the MAILADMIN_* values. Runs in a clean environment, so only the file counts.
load_config() {
    local entries entry key value
    # shellcheck disable=SC2016  # expanded by the inner shell, on purpose
    mapfile -d '' entries < <(env -i "$BASH" -c '
        set -a; . "$1"; set +a
        for name in ${!MAILADMIN_@}; do printf "%s=%s\0" "$name" "${!name}"; done
    ' _ "$env_file") || die "$env_file could not be read as a shell file"

    for entry in "${entries[@]}"; do
        key=${entry%%=*}
        value=${entry#*=}
        # shellcheck disable=SC1003  # a literal backslash, not an escaped quote
        case "$value" in
            *'"'*|*$'\n'*|*'\'*)
                die "$env_file: $key contains a double quote, backslash or line break, which the php-fpm pool cannot carry" ;;
        esac
        config[$key]=$value
    done
}

validate_config() {
    local problems=() key value decoded
    for key in "${REQUIRED_KEYS[@]}"; do
        value=${config[$key]:-}
        if [ -z "$value" ] || [[ $value == *"$PLACEHOLDER"* ]]; then
            problems+=("$key is missing or still '$PLACEHOLDER'")
        fi
    done
    if [ "${config[MAILADMIN_ENV]:-}" != 'prod' ]; then
        problems+=("MAILADMIN_ENV must be 'prod' on a server")
    fi
    value=${config[MAILADMIN_JWT_SIGNING_KEY]:-}
    if [ -n "$value" ] && [[ $value != *"$PLACEHOLDER"* ]]; then
        decoded=$(printf '%s' "$value" | base64 -d 2>/dev/null | wc -c) || decoded=0
        if [ "$decoded" -ne 32 ]; then
            problems+=('MAILADMIN_JWT_SIGNING_KEY must be 32 bytes, base64 (openssl rand -base64 32)')
        fi
    fi
    if [ "${config[MAILADMIN_BASE_PATH]:-}" != "$base_path" ]; then
        problems+=("MAILADMIN_BASE_PATH is '${config[MAILADMIN_BASE_PATH]:-}', but --base-path is '$base_path'; the frontend is built for the latter and both must match")
    fi

    if [ "${#problems[@]}" -gt 0 ]; then
        printf '\n%s is not complete:\n' "$env_file" >&2
        printf '  - %s\n' "${problems[@]}" >&2
        exit 1
    fi
}

# KEY=value arguments for `env`, from the loaded configuration.
config_assignments() {
    local key
    for key in $(printf '%s\n' "${!config[@]}" | LC_ALL=C sort); do
        printf '%s=%s\0' "$key" "${config[$key]}"
    done
}

create_env_file() {
    local jwt_key group=''
    jwt_key=$(head -c 32 /dev/urandom | base64)
    if [ "$system" -eq 1 ] && id "$app_user" >/dev/null 2>&1; then
        group=$app_user
    fi

    write_file "$env_file" 0640 "$group" <<EOF
# mailadmin production configuration. $MARKER.
#
# One KEY='value' per line. No double quotes, backslashes or line breaks inside
# a value. Read by the php-fpm pool (regenerated from this file by bin/install)
# and by /usr/local/sbin/mailadmin. Every variable is explained in .env.example.
#
# After a change: run bin/install again — it regenerates the pool.

MAILADMIN_ENV='prod'
MAILADMIN_BASE_PATH='$base_path'
MAILADMIN_LOG_LEVEL='info'

# Its own database user, not the one Postfix and pam_mysql use.
MAILADMIN_DB_DSN='${prefill_db_dsn:-mysql:host=localhost;port=3306;dbname=$PLACEHOLDER;charset=utf8mb4}'
MAILADMIN_DB_USER='${prefill_db_user:-$PLACEHOLDER}'
MAILADMIN_DB_PASSWORD='$PLACEHOLDER'

# Generated by the installer: 32 random bytes, base64 (Ed25519 seed).
MAILADMIN_JWT_SIGNING_KEY='$jwt_key'

# Cyrus. The administrator must be listed in 'admins' and may proxy for users.
MAILADMIN_IMAP_HOST='${prefill_imap_host:-$PLACEHOLDER}'
MAILADMIN_IMAP_PORT='993'
MAILADMIN_IMAP_TLS='implicit'
MAILADMIN_IMAP_ADMIN_USER='${prefill_imap_admin:-$PLACEHOLDER}'
MAILADMIN_IMAP_ADMIN_PASSWORD='$PLACEHOLDER'
#MAILADMIN_IMAP_CA_FILE='/etc/ssl/certs/mailadmin-ca.pem'
MAILADMIN_MANAGESIEVE_PORT='4190'

# Naming scheme for NEW accounts only: dotted | fqun.
MAILADMIN_NAMING_SCHEME='dotted'
EOF

    if [ "$dry_run" -eq 1 ]; then
        info "[dry-run] the real run stops here until $env_file is completed"
        return 0
    fi
    printf '\nThe configuration file %s has been created, with a freshly generated\n' "$env_file"
    printf "signing key. Replace every '%s', then run the installer again.\n" "$PLACEHOLDER"
    printf 'Nothing else has been changed.\n'
    env_created=1
    exit 2
}

# --- steps ------------------------------------------------------------------------

step_install_packages() {
    [ "$install_packages" -eq 1 ] || return 0
    log 'installing packages (apt-get)'
    command -v apt-get >/dev/null || die '--install-packages supports Debian and Ubuntu (apt-get) only.'
    local v=${php_version:-8.3}
    run apt-get update
    run env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git unzip ca-certificates composer nodejs npm \
        "php$v-cli" "php$v-fpm" "php$v-mysql" "php$v-mbstring"
}

step_preflight() {
    log 'checking prerequisites'
    if [ "$system" -eq 1 ] && ! is_root && [ "$dry_run" -eq 0 ]; then
        die 'a server installation needs root. Use --no-system to only fetch, build and migrate.'
    fi

    local tool
    for tool in git php composer node npm; do
        command -v "$tool" >/dev/null \
            || die "'$tool' not found in PATH (docs/deployment/installation.md, step 1; or --install-packages)"
    done

    local php_line
    php_line=$(php --version | head -n 1)
    [[ $php_line =~ ^PHP\ ([0-9]+)\.([0-9]+) ]] || die "cannot read the PHP version from: $php_line"
    local major=${BASH_REMATCH[1]} minor=${BASH_REMATCH[2]}
    if [ "$major" -lt "$MIN_PHP_MAJOR" ] || { [ "$major" -eq "$MIN_PHP_MAJOR" ] && [ "$minor" -lt "$MIN_PHP_MINOR" ]; }; then
        die "PHP $MIN_PHP_MAJOR.$MIN_PHP_MINOR or newer is required, found $major.$minor"
    fi
    php_version=${php_version:-$major.$minor}
    info "php $major.$minor"

    local modules extension missing=()
    modules=$(php -m | tr '[:upper:]' '[:lower:]')
    for extension in "${PHP_EXTENSIONS[@]}"; do
        grep -qx "$extension" <<<"$modules" || missing+=("$extension")
    done
    [ "${#missing[@]}" -eq 0 ] \
        || die "PHP extensions missing: ${missing[*]} (Debian/Ubuntu: php$php_version-mysql, php$php_version-mbstring)"

    local node
    node=$(node --version)
    [[ $node =~ ^v([0-9]+) ]] && [ "${BASH_REMATCH[1]}" -ge "$MIN_NODE" ] \
        || die "Node $MIN_NODE or newer is required for the build, found $node"
    info "node $node"

    if [ "$system" -eq 1 ]; then
        command -v "php-fpm$php_version" >/dev/null || [ "$dry_run" -eq 1 ] \
            || die "php-fpm$php_version not found; install php$php_version-fpm"
        getent group "$web_group" >/dev/null || die "web server group '$web_group' does not exist (--web-group)"
        command -v runuser >/dev/null || [ "$dry_run" -eq 1 ] || die 'runuser not found (util-linux)'
    fi

    if [ "$apache" -eq 1 ]; then
        [ -n "$server_name" ] && [ -n "$tls_cert" ] && [ -n "$tls_key" ] \
            || die '--apache needs --server-name, --tls-cert and --tls-key'
        [ -z "$base_path" ] \
            || die '--apache sets up variant A (own vHost, public/ as DocumentRoot); --base-path must stay empty'
        command -v apache2ctl >/dev/null || die '--apache: apache2ctl not found'
        local value
        for value in "$server_name" "$tls_cert" "$tls_key" "$prefix" "$fpm_socket"; do
            [[ $value =~ ^[A-Za-z0-9._/-]+$ ]] || die "unexpected character in '$value'"
        done
    fi
}

step_user() {
    [ "$system" -eq 1 ] || return 0
    if id "$app_user" >/dev/null 2>&1; then
        info "system user '$app_user' exists"
        return 0
    fi
    log "creating system user '$app_user'"
    run useradd --system --create-home --home-dir "/var/lib/$app_user" --shell /usr/sbin/nologin "$app_user"
}

step_config() {
    log "configuration: $env_file"
    if [ ! -e "$env_file" ]; then
        create_env_file
        return 0
    fi
    load_config
    validate_config
    info "${#config[@]} settings, all required ones present"
}

default_repo() {
    local checkout
    checkout=$(dirname "$script_dir")
    [ -e "$checkout/.git" ] || return 0
    (cd "$checkout" && git -c safe.directory="$checkout" remote get-url origin 2>/dev/null) || true
}

release=''
staging=''
activated=0
git_trust=''
env_created=0

# A run that fails before the switch leaves the active release untouched; the
# half-built one is removed so that it never becomes a rollback target.
on_exit() {
    local status=$?
    [ -n "$git_trust" ] && rm -f "$git_trust"
    if [ "$status" -ne 0 ] && [ "$env_created" -eq 0 ] && [ "$activated" -eq 0 ] && [ "$dry_run" -eq 0 ]; then
        [ -n "$staging" ] && rm -rf "$staging"
        [ -n "$release" ] && [ -d "$release" ] && rm -rf "$release"
        printf '\nmailadmin install: aborted (exit %s). The active release is unchanged.\n' "$status" >&2
    fi
}

step_fetch() {
    repo=${repo:-$(default_repo)}
    [ -n "$repo" ] || die "no --repo given, and this script is not in a git checkout with an 'origin'"
    log "fetching $repo${ref:+ at $ref}"

    local releases="$prefix/releases"
    staging="$releases/.incoming-$$"

    if [ "$dry_run" -eq 1 ]; then
        info "[dry-run] git clone $repo -> $releases/<timestamp>-<revision>"
        release="$releases/<new>"
        return 0
    fi

    mkdir -p "$releases"
    rm -rf "$staging"
    mkdir "$staging"
    if [ "$system" -eq 1 ]; then
        chmod 0755 "$prefix" "$releases"
        chown "$app_user:$app_user" "$staging"
    fi

    # A local checkout usually belongs to someone else than the build user, and
    # git refuses to read such a repository unless it is listed as safe — in
    # global or system configuration only, `-c` does not count. A throwaway
    # global configuration names exactly this one directory.
    local trust=()
    if [ -d "$repo" ]; then
        local source
        source=$(cd "$repo" && pwd)
        git_trust=$(mktemp)
        printf '[safe]\n\tdirectory = %s\n\tdirectory = %s/.git\n' "$source" "$source" >"$git_trust"
        chmod 0644 "$git_trust"
        trust=("GIT_CONFIG_GLOBAL=$git_trust")
    fi
    (cd "$staging" && as_app "${trust[@]}" -- git clone --quiet "$repo" .)
    if [ -n "$ref" ]; then
        # A tag or commit resolves as given, a branch only as origin/<branch>.
        local commit
        commit=$(cd "$staging" && { as_app -- git rev-parse --quiet --verify "$ref^{commit}" \
                    || as_app -- git rev-parse --quiet --verify "origin/$ref^{commit}"; }) \
            || die "unknown --ref '$ref': no such branch, tag or commit in $repo"
        (cd "$staging" && as_app -- git checkout --quiet --detach "$commit")
    fi

    local revision stamp
    revision=$(cd "$staging" && as_app -- git rev-parse HEAD)
    stamp=$(date -u +%Y%m%d%H%M%S)
    release="$releases/$stamp-${revision:0:10}"
    mv "$staging" "$release"
    staging=''
    printf '%s\n' "$revision" >"$release/REVISION"
    info "release $(basename "$release")"
}

step_build() {
    local build_env=(
        'COMPOSER_NO_INTERACTION=1'
        "MAILADMIN_BASE_PATH=$base_path"
        'npm_config_fund=false'
        'npm_config_audit=false'
        'npm_config_update_notifier=false'
    )

    log 'building the backend (composer install --no-dev)'
    (cd "$release" 2>/dev/null || [ "$dry_run" -eq 1 ]
     as_app "${build_env[@]}" -- composer install --no-dev --prefer-dist --optimize-autoloader --no-progress
     as_app "${build_env[@]}" -- composer check-platform-reqs --no-dev)

    # The steps `npm run build` chains through prebuild and postbuild, spelled
    # out: an `ignore-scripts=true` in some npmrc would otherwise skip the
    # generated API types and, worse, the CSP check of the result.
    log 'building the frontend'
    (cd "$release/frontend" 2>/dev/null || [ "$dry_run" -eq 1 ]
     as_app "${build_env[@]}" -- npm ci
     as_app "${build_env[@]}" -- node scripts/clean-output.mjs
     as_app "${build_env[@]}" -- npm run api:types
     as_app "${build_env[@]}" -- npx --no-install tsc --build --force
     as_app "${build_env[@]}" -- npx --no-install vite build
     as_app "${build_env[@]}" -- node scripts/check-build.mjs)

    if [ "$keep_node_modules" -eq 0 ]; then
        info 'removing frontend/node_modules (needed for the build only)'
        run rm -rf "$release/frontend/node_modules"
    fi
    run rm -rf "$release/.git"

    if [ "$system" -eq 1 ]; then
        log 'ownership: code root-owned and read-only, var/ writable for the pool'
        run chown -R root:root "$release"
        run chmod -R go-w "$release"
        run chown -R "$app_user:$app_user" "$release/var"
    fi
}

# as_app with the production configuration.
as_app_configured() {
    local assignments=()
    if [ "${#config[@]}" -gt 0 ]; then
        mapfile -d '' assignments < <(config_assignments)
    fi
    as_app "${assignments[@]}" -- "$@"
}

step_migrate() {
    if [ "$skip_migrate" -eq 1 ]; then
        log 'skipping migrations (--skip-migrate); the new release refuses service until they have run'
        return 0
    fi
    log 'database: migrate'
    (cd "$release" 2>/dev/null || [ "$dry_run" -eq 1 ]
     as_app_configured php bin/migrate.php)

    # db-check: 0 clean, 2 warnings — MyISAM on a legacy schema is one, and
    # expected —, 1 the database could not be read. Only the last one stops.
    log 'database: check'
    local status=0
    (cd "$release" 2>/dev/null || [ "$dry_run" -eq 1 ]
     as_app_configured php bin/db-check.php) || status=$?
    case "$status" in
        0) ;;
        2) info 'db-check reported warnings (see above); they do not block the installation' ;;
        *) die "bin/db-check.php failed with exit code $status" ;;
    esac
}

step_pool() {
    [ "$system" -eq 1 ] || return 0
    local pool
    pool=$(pool_file)
    log "php-fpm pool $pool"
    guard_generated "$pool"

    {
        cat <<EOF
; $MARKER from $env_file.
; Do not edit: the next installer run overwrites it. Holds secrets, root only.

[mailadmin]
user = $app_user
group = $app_user

listen = $fpm_socket
listen.owner = $web_group
listen.group = $web_group
listen.mode = 0660

pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 60s
pm.max_requests = 500

; The configuration comes from here and nowhere else (U-11).
clear_env = yes

php_admin_value[date.timezone] = UTC
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on

EOF
        # php-fpm refuses `env[X] = ""`. An empty value means "use the
        # default", which is what leaving the variable out does as well.
        local key
        for key in $(printf '%s\n' "${!config[@]}" | LC_ALL=C sort); do
            if [ -n "${config[$key]}" ]; then
                printf 'env[%s] = "%s"\n' "$key" "${config[$key]}"
            fi
        done
    } | write_file "$pool.new" 0640

    # A pool file php-fpm cannot read takes every pool on the server down at the
    # next reload, not just this one. The new file only stays if the test passes.
    if [ "$dry_run" -eq 1 ]; then
        run "php-fpm$php_version" -t
        return 0
    fi
    local backup=''
    if [ -e "$pool" ]; then
        backup="$pool.previous"
        cp -p "$pool" "$backup"
    fi
    mv -f "$pool.new" "$pool"
    if ! "php-fpm$php_version" -t; then
        if [ -n "$backup" ]; then mv -f "$backup" "$pool"; else rm -f "$pool"; fi
        die "php-fpm rejected the generated pool; the previous state is restored"
    fi
    rm -f "$backup"
}

step_activate() {
    local name
    name=$(basename "$release")
    log "activating $name"
    switch_to "$name"
    activated=1
    reload_fpm
}

step_cli_and_cron() {
    [ "$system" -eq 1 ] || return 0
    log 'command line wrapper and cron job'

    write_file /usr/local/sbin/mailadmin 0755 <<EOF
#!/bin/sh
# $MARKER.
# Runs a mailadmin command line tool with the production configuration:
#
#   mailadmin migrate [status|--dry-run]
#   mailadmin db-check
#   mailadmin prune-tokens [--dry-run]
#   mailadmin check-deployment https://host
set -eu

if [ "\$#" -lt 1 ]; then
    echo "usage: mailadmin <$CLI_COMMANDS> [arguments]" >&2
    exit 64
fi

command=\$1
shift

case "\$command" in
    $CLI_COMMANDS) ;;
    *) echo "mailadmin: unknown command '\$command'" >&2; exit 64 ;;
esac

set -a
. '$env_file'
set +a

exec php '$prefix/current/bin/'"\$command"'.php' "\$@"
EOF

    write_file /etc/cron.d/mailadmin 0644 <<EOF
# $MARKER.
# Removes expired refresh tokens, denylist rows and sign-in attempts (S2).
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
17 * * * * $app_user /usr/local/sbin/mailadmin prune-tokens >/dev/null
EOF
}

step_apache() {
    [ "$apache" -eq 1 ] || return 0
    log 'apache vHost (variant A)'
    local target=/etc/apache2/sites-available/mailadmin.conf
    local example="$release/docs/deployment/apache-vhost.conf.example"
    [ "$dry_run" -eq 0 ] || example="$(dirname "$script_dir")/docs/deployment/apache-vhost.conf.example"
    guard_generated "$target"

    run a2enmod -q rewrite headers proxy_fcgi setenvif ssl

    # The shipped example with its placeholders filled in. Variant B (the
    # commented tail) is dropped, and so are the SetEnv lines: the configuration
    # reaches PHP through the pool.
    {
        printf '# %s.\n' "$MARKER"
        awk '/^# -----/ { exit } { print }' "$example" \
            | grep -v '^[[:space:]]*SetEnv ' \
            | sed -e "s|/etc/ssl/certs/mail.example.test.pem|$tls_cert|" \
                  -e "s|/etc/ssl/private/mail.example.test.key|$tls_key|" \
                  -e "s|mail\.example\.test|$server_name|g" \
                  -e "s|/srv/mailadmin|$prefix/current|g" \
                  -e "s|/run/php/mailadmin.sock|$fpm_socket|g"
    } | write_file "$target" 0644

    run a2ensite -q mailadmin
    run apache2ctl configtest
    run systemctl reload apache2
}

healthy=1

step_verify() {
    local url
    url=$(public_url) || true
    if [ -z "$url" ]; then
        log 'skipping the deployment check (no --server-name)'
        return 0
    fi
    log "deployment check against $url"
    if ! (cd "$prefix/current" 2>/dev/null || [ "$dry_run" -eq 1 ]
          as_app -- php bin/check-deployment.php "$url"); then
        healthy=0
    fi
}

step_prune() {
    local active all=() name i
    active=$(active_release) || true
    mapfile -t all < <(list_releases)
    [ "${#all[@]}" -gt "$keep_releases" ] || return 0
    for ((i = 0; i < ${#all[@]} - keep_releases; i++)); do
        name=${all[$i]}
        [ "$name" = "$active" ] && continue
        info "removing old release $name"
        run rm -rf "${prefix:?}/releases/$name"
    done
}

do_rollback() {
    local active previous='' name
    active=$(active_release) || die "$prefix/current is not a symlink; nothing to roll back"
    while IFS= read -r name; do
        [[ $name < $active ]] && previous=$name
    done < <(list_releases)
    [ -n "$previous" ] || die 'there is no older release to roll back to'

    if [ "$system" -eq 1 ] && [ -z "$php_version" ]; then
        local php_line
        php_line=$(php --version | head -n 1)
        [[ $php_line =~ ^PHP\ ([0-9]+\.[0-9]+) ]] && php_version=${BASH_REMATCH[1]}
    fi

    log "rolling back $active -> $previous"
    info 'Migrations are not reversed. They are additive, so the older release runs on the newer schema.'
    switch_to "$previous"
    reload_fpm
}

# --- main -------------------------------------------------------------------------

main() {
    parse_args "$@"
    trap on_exit EXIT

    if [ "$rollback" -eq 1 ]; then
        do_rollback
        exit 0
    fi

    step_install_packages
    step_preflight
    step_user
    step_config
    step_fetch
    step_build
    step_migrate
    step_pool
    step_activate
    step_cli_and_cron
    step_apache
    step_verify
    step_prune

    printf '\n'
    if [ "$dry_run" -eq 1 ]; then
        printf 'Dry run finished. Nothing was changed.\n'
        exit 0
    fi
    printf 'Installed %s into %s.\n' "$(basename "$release")" "$prefix"
    if [ "$system" -eq 1 ] && [ "$apache" -eq 0 ]; then
        printf 'Web server: DocumentRoot %s/current/public, PHP handler %s\n' "$prefix" "$fpm_socket"
        printf '(docs/deployment/apache-vhost.conf.example or nginx.conf.example).\n'
    fi
    if [ "$healthy" -eq 0 ]; then
        printf 'The deployment check FAILED, see above. The release is active: fix the web server\n'
        printf 'configuration, or go back with: bin/install --rollback\n'
        exit 1
    fi
}

main "$@"
