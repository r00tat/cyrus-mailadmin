# mailadmin — example configuration.
#
# Copy to `.env` for development only. `.env` is read exclusively when
# MAILADMIN_ENV is not `prod`, phpdotenv (a require-dev package) is installed and
# the file exists — see U-11. In production the configuration comes from the
# process environment and no `.env` is involved.
#
# Never commit a filled-in `.env`. Never put a real host name, domain or password
# in this file.

# =============================================================================
# Core (F1)
# =============================================================================

# Mandatory. One of: dev | test | prod
# Without it the application refuses to start. There is no default, because
# guessing wrong in either direction is harmful: a production instance treated as
# development would load a `.env`, expose the schema browser (U-9) and rebuild
# artefacts under load.
MAILADMIN_ENV=dev

# `stderr` (default) or an absolute file path. A path switches to a rotating file
# handler; if it cannot be written the application logs to stderr instead and says
# so once — a log destination is never a reason to refuse service (U-12).
MAILADMIN_LOG_TARGET=stderr

# debug | info | notice | warning | error | critical | alert | emergency
# Default: info
MAILADMIN_LOG_LEVEL=debug

# Directory for build artefacts: bundled specification, compiled route table,
# checksum. Default: <project>/var/cache. Must be writable, otherwise startup
# fails — in every environment (U-13).
#MAILADMIN_CACHE_DIR=/var/lib/mailadmin/cache

# Base path if the application is not mounted at `/`. No trailing slash.
# Example: MAILADMIN_BASE_PATH=/mailadmin
MAILADMIN_BASE_PATH=

# =============================================================================
# Contract and documentation (F2)
# =============================================================================

# Serves the bundled contract under /api/docs/openapi.json. Off in production,
# on otherwise (U-9). Set to 1 to switch it on in production as well — it reveals
# the complete attack surface, so this is a deliberate choice, not a default.
#
# There is no Redoc. The original reason was the CSP, and U-35 removed it; what
# is left is a megabyte of bundled JavaScript in the repository for a viewer that
# can be pointed at the JSON instead. Open point O-12.
#MAILADMIN_API_DOCS=0

# =============================================================================
# Password hashing (S1)
# =============================================================================

# All optional; the defaults apply without them. Targets are not configurable:
# adminuser gets Argon2id, accountuser gets bcrypt, because pam_mysql reads the
# latter through crypt(3) (E-3). Only the cost is tunable.

# 10..15. pam_mysql pays this on every IMAP and SMTP login, so measure on the
# target hardware before raising it.
#MAILADMIN_PASSWORD_BCRYPT_COST=10

# Argon2id, for adminuser only. Floors: 19456 KiB and time cost 2.
#MAILADMIN_PASSWORD_ARGON2_MEMORY_KIB=65536
#MAILADMIN_PASSWORD_ARGON2_TIME_COST=4
#MAILADMIN_PASSWORD_ARGON2_THREADS=1

# =============================================================================
# Database (F3)
# =============================================================================

# PDO DSN. Must start with "mysql:"; charset=utf8mb4 is added or corrected
# automatically (architecture 10.1).
#MAILADMIN_DB_DSN=mysql:host=CHANGEME;port=3306;dbname=CHANGEME;charset=utf8mb4

# Its own user — not the one Postfix and pam_mysql use. Write access to the
# managed tables, read access to the views (architecture 10.1, finding S-12).
#MAILADMIN_DB_USER=CHANGEME
#MAILADMIN_DB_PASSWORD=CHANGEME

# Seconds to wait for a connection. Default: 5
#MAILADMIN_DB_TIMEOUT=5

# Whether the migrator may run on first access instead of refusing service.
# Off by default; it takes the same GET_LOCK the command line does. See O-4 —
# whether this variable ships at all is an operations decision.
#MAILADMIN_AUTO_MIGRATE=0

# Seconds to wait for that lock before giving up without changing anything.
# Default: 10
#MAILADMIN_MIGRATION_LOCK_TIMEOUT=10

# --- Integration tests only --------------------------------------------------
# Without these the persistence integration suite reports itself as skipped —
# never as passed. Point it at a throwaway database: it creates and drops tables.
#MAILADMIN_TEST_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=mailadmin_test
#MAILADMIN_TEST_DB_USER=CHANGEME
#MAILADMIN_TEST_DB_PASSWORD=CHANGEME

# =============================================================================
# Tokens and sign-in (S2)
# =============================================================================

# REQUIRED. The Ed25519 seed the access token is signed with: 32 random bytes,
# base64. Generate one with
#
#     openssl rand -base64 32
#
# There is no default and no fallback. A key generated at startup would sign
# everyone out at every deployment; a shipped default would be a shipped
# administrator account. The application refuses to start without this.
#MAILADMIN_JWT_SIGNING_KEY=CHANGEME

# Rotation, without signing anyone out: put the new key above, move the retiring
# one here, and remove this line once the longest access-token lifetime has
# passed. Tokens carry the key id in their header, so both verify side by side.
# This key never signs anything.
#MAILADMIN_JWT_SIGNING_KEY_PREVIOUS=

# The `iss` and `aud` claims. The defaults are fine and are what the audience
# check compares against; change them only if a second service shares this key,
# and change them on both sides at once — every token in the field stops
# verifying the moment they differ.
#MAILADMIN_JWT_ISSUER=mailadmin
#MAILADMIN_JWT_AUDIENCE=mailadmin-api

# Access token lifetime in seconds. 3600 is a decision, not a default (E-10),
# and the accepted range is 300..3600: E-15 keeps the access token in
# localStorage and trades that against a short life, so this is the one value
# that must not be raised to save sign-ins. It can be lowered.
#MAILADMIN_ACCESS_TOKEN_TTL=3600

# Absolute lifetime of a refresh family, in seconds. Accepted range 900..43200.
# A rotation copies this deadline rather than extending it, so twelve hours is
# twelve hours from signing in, not from the last request.
#MAILADMIN_REFRESH_TOKEN_TTL=43200

# The refresh cookie is always sent with `Secure`, and there is no switch for
# it. mailadmin sends HSTS unconditionally and is HTTPS-only by design; over
# plain HTTP the cookie will simply not be stored, which is the intended and
# very visible failure.
#
# Expired tokens, denylist rows and sign-in attempts are removed by
# `php bin/prune-tokens.php`. Hourly is plenty. Nothing breaks if it does not
# run — the rows are merely dead weight.

# =============================================================================
# Cyrus / mailstore (M1, M2)
# =============================================================================

#MAILADMIN_IMAP_HOST=CHANGEME

# 993 for IMAPS (the default), 143 for STARTTLS.
#MAILADMIN_IMAP_PORT=993

# implicit (default, IMAPS) | starttls
#
# TLS is mandatory either way, including certificate verification. This chooses
# *when* the handshake happens, not whether — there is no plaintext mode and no
# variable that disables the certificate check (architecture 9.2, finding S-5).
# The legacy client spoke clear text on 143 and sent this password across it.
#MAILADMIN_IMAP_TLS=implicit

# A private CA bundle, if the server's certificate is not signed by a public one.
# It has to be readable: an unreadable bundle makes OpenSSL fall back to the
# system trust store, so the connection would verify against the wrong anchor
# unnoticed. The application refuses to start instead.
#MAILADMIN_IMAP_CA_FILE=/etc/ssl/private/mailadmin-ca.pem

# An account in Cyrus's `admins` line, and one that may proxy for users
# (`proxyservers`). Folders are created in a user's name through SASL proxy
# authorisation — no user password is ever involved (architecture 9.3).
#MAILADMIN_IMAP_ADMIN_USER=CHANGEME
#MAILADMIN_IMAP_ADMIN_PASSWORD=CHANGEME

# Whole seconds. Separate, because they fail for different reasons: a connect
# timeout is usually a firewall, a read timeout is a server that took the command
# and is thinking. Floor: 1.
#MAILADMIN_IMAP_CONNECT_TIMEOUT=10
#MAILADMIN_IMAP_READ_TIMEOUT=30

# An IMAP transcript in the log. Off by default and **ineffective in prod**: a
# transcript records every mailbox name of every customer. Commands that carry a
# credential are redacted whatever this is set to.
#MAILADMIN_IMAP_TRACE=0

# ManageSieve (M3). The only variable Sieve has of its own — host, CA bundle,
# timeouts and administrator are the same server's and come from the settings
# above. TLS is always STARTTLS and there is nothing to choose: RFC 5804 defines
# no implicit-TLS port and Cyrus offers none, so the connection starts in the
# clear and is upgraded before a credential is written.
#
# The server needs `allowstarttls: yes`, which Cyrus does NOT set by default.
# Without it ManageSieve has no encrypted path at all and mailadmin refuses to
# use it (docs/deployment/README.md).
#MAILADMIN_MANAGESIEVE_PORT=4190

# --- Integration tests only --------------------------------------------------
# Without these the mailstore integration suite reports itself as skipped —
# never as passed. F5 provides all of them; see docker/compose.yaml.
#MAILADMIN_TEST_IMAP_HOST=127.0.0.1
#MAILADMIN_TEST_IMAP_PORT=993
#MAILADMIN_TEST_IMAP_CA_FILE=docker/certs/out/ca.pem
#MAILADMIN_TEST_IMAP_ADMIN_USER=CHANGEME
#MAILADMIN_TEST_IMAP_ADMIN_PASSWORD=CHANGEME
# Naming scheme for new accounts: dotted | fqun. Existing accounts keep the scheme
# their mailbox actually uses — it is detected, never configured (E-14).
#MAILADMIN_NAMING_SCHEME=dotted
# Mailing lists: pseudo-domain of the Postfix pipe transport (virtual.dest of a list
# is <address with @ as .>@<this>), and whether lists still go through the alias
# file (alias) or already through the transport (transport).
#MAILADMIN_LIST_TRANSPORT_DOMAIN=maillist.invalid
#MAILADMIN_LIST_DELIVERY=alias
