# Postfix master — test environment.
#
# NOTHING IS CHROOTED (the `n` in the chroot column). Debian chroots most
# services into /var/spool/postfix, which then needs a copy of /etc/resolv.conf,
# /etc/services, the mysql socket and the saslauthd socket inside the jail.
# That is a production hardening measure; here it would only produce a class of
# failures that says nothing about the application. The saslauthd socket
# therefore stays at its normal place, /run/saslauthd, where Cyrus also finds it.
#
# service  type  private unpriv  chroot  wakeup  maxproc  command + args
#                (yes)   (yes)   (no)    (never) (100)
# ==========================================================================
smtp       inet  n       -       n       -       -       smtpd

# Submission. STARTTLS is mandatory here, and so is authentication: this is the
# port the SMTP-AUTH part of the Definition of Done runs against.
587        inet  n       -       n       -       -       smtpd
    -o syslog_name=postfix/submission
    -o smtpd_tls_security_level=encrypt
    -o smtpd_sasl_auth_enable=yes
    -o smtpd_client_restrictions=permit_sasl_authenticated,reject
    -o smtpd_relay_restrictions=permit_sasl_authenticated,reject

pickup     unix  n       -       n       60      1       pickup
cleanup    unix  n       -       n       -       0       cleanup
qmgr       unix  n       -       n       300     1       qmgr
tlsmgr     unix  -       -       n       1000?   1       tlsmgr
rewrite    unix  -       -       n       -       -       trivial-rewrite
bounce     unix  -       -       n       -       0       bounce
defer      unix  -       -       n       -       0       bounce
trace      unix  -       -       n       -       0       bounce
verify     unix  -       -       n       -       1       verify
flush      unix  n       -       n       1000?   0       flush
proxymap   unix  -       -       n       -       -       proxymap
proxywrite unix  -       -       n       -       1       proxymap
smtp       unix  -       -       n       -       -       smtp
relay      unix  -       -       n       -       -       smtp
showq      unix  n       -       n       -       -       showq
error      unix  -       -       n       -       -       error
retry      unix  -       -       n       -       -       error
discard    unix  -       -       n       -       -       discard
local      unix  -       n       n       -       -       local
virtual    unix  -       n       n       -       -       virtual
lmtp       unix  -       -       n       -       -       lmtp
anvil      unix  -       -       n       -       1       anvil
scache     unix  -       -       n       -       1       scache
postlog    unix-dgram n  -       n       -       1       postlogd

# Mailing lists (docs/deployment/maillist.md, section 3). The same line as in
# production except for the command: a stub that logs the list key and the
# message instead of maillist.py. `${user}`, not `${mailbox}`, so that the
# extension of `team+x@…` does not become part of the key.
maillist   unix  -       n       n       -       -       pipe
    flags=Rq user=nobody argv=/usr/local/bin/maillist-stub.sh -- ${user}
